# ANTHROPIC_API_KEY: Claude API key (server-side only) — powers 3D generation and edits.
ANTHROPIC_API_KEY="sk-ant-..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Harakumo — accounts, database, storage and mail (https://harakumo.com/api/docs/all)
# HARAKUMO_API_KEY: an org API key (Dashboard → Settings → API Keys).
# The ids and secrets below come from provisioning: a project, a sqlite database,
# a storage bucket and an auth pool. The pool's jwtSecret is only shown once.
HARAKUMO_API_KEY="hk_live_..."
HARAKUMO_PROJECT_ID=""
HARAKUMO_DATABASE_ID=""
HARAKUMO_BUCKET_ID=""
HARAKUMO_AUTH_POOL_ID=""
HARAKUMO_AUTH_JWT_SECRET=""
HARAKUMO_AUTH_CLIENT_SECRET=""
